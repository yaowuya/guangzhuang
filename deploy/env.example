# 复制为 deploy/.env，替换真实域名；IMAGE_TAG 必须是待发布干净提交的完整 Git SHA。
DOMAIN=beauty.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=replace-with-full-git-sha
HTTP_PORT=80
HTTPS_PORT=443
APP_SUBNET=172.30.0.0/24
CADDY_IPV4=172.30.0.2

# 路径相对仓库根的 docker-compose.yml。文件内容不得提交。
PASSWORD_HASH_FILE=./deploy/secrets/password.hash
CSRF_KEY_FILE=./deploy/secrets/csrf.key

# 可在受控环境覆盖，但应固定到已核验 patch/digest。
PYTHON_IMAGE=python:3.12.14-slim-bookworm
NODE_IMAGE=node:24.21.0-bookworm-slim
CADDY_IMAGE=caddy:2.10.2-alpine
